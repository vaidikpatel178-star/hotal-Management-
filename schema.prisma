// HOTELNEX AI Prisma Schema
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF") // SUPER_ADMIN, HOTEL_MANAGER, RECEPTIONIST, HOUSEKEEPING, RESTAURANT_MANAGER, KITCHEN_STAFF, ACCOUNTANT, STAFF
  phone        String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffProfile Staff?
  auditLogs    AuditLog[]
  conversations AIConversation[]
}

model Guest {
  id                  String   @id @default(uuid())
  name                String
  email               String?
  phone               String
  address             String?
  dateOfBirth         String?
  idType              String?  // Passport, Driving License, Aadhaar, National ID
  idNumber            String?
  nationality         String   @default("Indian")
  preferences         String?  // JSON or text: e.g. "Non-smoking, High Floor, Extra Pillows"
  dietaryPreference   String?  // Vegetarian, Jain, Vegan, Gluten-Free, Non-Veg
  favoriteRoomType    String?  // Deluxe Room, Suite, Executive Suite
  specialRequests     String?
  segment             String   @default("NEW") // NEW, REGULAR, VIP, HIGH_SPENDING, AT_RISK
  loyaltyTier         String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  loyaltyPoints       Int      @default(0)
  totalPointsEarned   Int      @default(0)
  totalPointsRedeemed Int      @default(0)
  totalStays          Int      @default(0)
  totalSpending       Float    @default(0.0)
  lastVisitDate       DateTime?
  isAtRisk            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  documents           GuestDocument[]
  reservations        Reservation[]
  checkIns            CheckIn[]
  checkOuts           CheckOut[]
  invoices            Invoice[]
  foodOrders          FoodOrder[]
  reviews             Review[]
  hallBookings        HallBooking[]
  events              Event[]
  notes               GuestNote[]
  loyaltyTransactions LoyaltyTransaction[]
  rewardRedemptions   RewardRedemption[]
  communicationLogs   CommunicationLog[]
}

model GuestDocument {
  id           String   @id @default(uuid())
  guestId      String
  documentType String   // ID Proof, Visa, Passport
  documentUrl  String
  uploadedAt   DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model RoomType {
  id          String   @id @default(uuid())
  name        String   // Standard, Deluxe, Premium, Suite, Family
  code        String   @unique
  basePrice   Float
  description String?
  capacity    Int      @default(2)
  bedType     String   @default("King") // King, Queen, Twin, Double
  amenities   String   // Comma separated e.g. "Wi-Fi, AC, TV, Mini Bar, Sea View"
  image       String?
  createdAt   DateTime @default(now())

  rooms Room[]
}

model Room {
  id                  String   @id @default(uuid())
  roomNumber          String   @unique
  roomTypeId          String
  floor               Int      @default(1)
  building            String   @default("Main Wing")
  pricePerNight       Float
  weekendPrice        Float    @default(0.0)
  extraGuestPrice     Float    @default(500.0)
  capacity            Int      @default(2)
  bedType             String   @default("King")
  numberOfBeds        Int      @default(1)
  roomSize            Int      @default(35)
  amenities           String
  image               String?
  status              String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, CLEANING, MAINTENANCE, OUT_OF_SERVICE
  housekeepingStatus  String   @default("CLEAN") // CLEAN, DIRTY, CLEANING, INSPECTION, READY
  isArchived          Boolean  @default(false)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  roomType            RoomType              @relation(fields: [roomTypeId], references: [id])
  reservations        Reservation[]
  checkIns            CheckIn[]
  checkOuts           CheckOut[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]
  foodOrders          FoodOrder[]
}

model Reservation {
  id             String   @id @default(uuid())
  bookingCode    String   @unique
  guestId        String
  roomId         String
  checkInDate    DateTime
  checkOutDate   DateTime
  adults         Int      @default(1)
  children       Int      @default(0)
  nights         Int      @default(1)
  roomRate       Float
  discount       Float    @default(0.0)
  tax            Float    @default(0.0)
  totalAmount    Float
  advancePayment Float    @default(0.0)
  remainingAmount Float
  source         String   @default("DIRECT") // DIRECT, WEBSITE, PHONE, WALK_IN, OTA
  status         String   @default("CONFIRMED") // CONFIRMED, PENDING, CHECKED_IN, CHECKED_OUT, CANCELLED, NO_SHOW
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guest    Guest    @relation(fields: [guestId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])
  checkIn  CheckIn?
  checkOut CheckOut?
  payments Payment[]
  invoices Invoice[]
}

model CheckIn {
  id             String   @id @default(uuid())
  reservationId  String   @unique
  roomId         String
  guestId        String
  checkInTime    DateTime @default(now())
  idVerified     Boolean  @default(true)
  keyCardNumber  String?
  initialDeposit Float    @default(0.0)
  notes          String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room        Room        @relation(fields: [roomId], references: [id])
  guest       Guest       @relation(fields: [guestId], references: [id])
}

model CheckOut {
  id                    String   @id @default(uuid())
  reservationId         String   @unique
  roomId                String
  guestId               String
  checkOutTime          DateTime @default(now())
  totalRoomCharges      Float
  totalRestaurantCharges Float   @default(0.0)
  totalServiceCharges   Float    @default(0.0)
  discounts             Float    @default(0.0)
  taxes                 Float    @default(0.0)
  finalAmount           Float
  paymentMethod         String   @default("CASH") // CASH, UPI, CARD, BANK_TRANSFER
  invoiceId             String?
  notes                 String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room        Room        @relation(fields: [roomId], references: [id])
  guest       Guest       @relation(fields: [guestId], references: [id])
}

model Payment {
  id            String   @id @default(uuid())
  reservationId String?
  orderId       String?
  invoiceId     String?
  eventId       String?
  amount        Float
  method        String   @default("CASH") // CASH, UPI, CARD, BANK_TRANSFER
  status        String   @default("PAID") // PAID, PARTIAL, PENDING, REFUNDED
  transactionId String?
  notes         String?
  createdAt     DateTime @default(now())

  reservation Reservation? @relation(fields: [reservationId], references: [id])
  foodOrder   FoodOrder?   @relation(fields: [orderId], references: [id])
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  event       Event?       @relation(fields: [eventId], references: [id])
}

model Invoice {
  id             String   @id @default(uuid())
  invoiceNumber  String   @unique
  guestId        String
  reservationId  String?
  checkOutId     String?
  eventId        String?
  issueDate      DateTime @default(now())
  dueDate        DateTime?
  subtotal       Float
  taxAmount      Float
  discountAmount Float    @default(0.0)
  grandTotal     Float
  status         String   @default("PAID") // PAID, UNPAID, PARTIAL, CANCELLED
  itemsJson      String   // JSON string of itemized breakdown
  createdAt      DateTime @default(now())

  guest       Guest        @relation(fields: [guestId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  event       Event?       @relation(fields: [eventId], references: [id])
  payments    Payment[]
}

model RestaurantTable {
  id             String   @id @default(uuid())
  tableNumber    String   @unique
  capacity       Int      @default(4)
  floor          String   @default("Main Dining")
  status         String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, BILL_REQUESTED
  currentOrderId String?

  orders FoodOrder[]
}

model MenuCategory {
  id           String   @id @default(uuid())
  name         String   @unique // Starters, Main Course, Pizza, Burger, Indian, Beverages, Desserts, Combos
  description  String?
  icon         String   @default("Utensils")
  displayOrder Int      @default(0)

  menuItems MenuItem[]
}

model MenuItem {
  id              String   @id @default(uuid())
  categoryId      String
  name            String
  description     String?
  image           String?
  price           Float
  costPrice       Float    @default(0.0)
  taxRate         Float    @default(5.0)
  isVeg           Boolean  @default(true)
  isJain          Boolean  @default(false)
  prepTimeMinutes Int      @default(15)
  isAvailable     Boolean  @default(true)
  isBestSeller    Boolean  @default(false)
  createdAt       DateTime @default(now())

  category   MenuCategory    @relation(fields: [categoryId], references: [id])
  recipe     Recipe?
  orderItems FoodOrderItem[]
}

model Ingredient {
  id           String   @id @default(uuid())
  name         String   @unique
  category     String   @default("General") // Dairy, Produce, Flour, Spices, Meat, Beverages
  unit         String   @default("kg") // kg, g, l, ml, pcs
  currentStock Float    @default(0.0)
  minimumStock Float    @default(5.0)
  purchasePrice Float   @default(0.0)
  supplierId   String?
  expiryDate   String?

  supplier          Supplier?              @relation(fields: [supplierId], references: [id])
  recipeIngredients RecipeIngredient[]
  transactions      InventoryTransaction[]
}

model Recipe {
  id           String   @id @default(uuid())
  menuItemId   String   @unique
  name         String
  instructions String?

  menuItem           MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  recipeIngredients RecipeIngredient[]
}

model RecipeIngredient {
  id               String @id @default(uuid())
  recipeId         String
  ingredientId     String
  quantityRequired Float  // e.g. 0.2 for 200g
  unit             String @default("kg")

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model FoodOrder {
  id            String   @id @default(uuid())
  orderNumber   String   @unique
  orderType     String   @default("DINE_IN") // DINE_IN, TAKEAWAY, ROOM_SERVICE, ONLINE
  tableId       String?
  roomId        String?
  guestId       String?
  status        String   @default("NEW") // NEW, CONFIRMED, PREPARING, READY, SERVED, COMPLETED, CANCELLED
  subtotal      Float
  tax           Float    @default(0.0)
  discount      Float    @default(0.0)
  totalAmount   Float
  paymentStatus String   @default("PENDING") // PENDING, PAID, BILLED_TO_ROOM
  kitchenNotes  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  table    RestaurantTable? @relation(fields: [tableId], references: [id])
  room     Room?            @relation(fields: [roomId], references: [id])
  guest    Guest?           @relation(fields: [guestId], references: [id])
  items    FoodOrderItem[]
  payments Payment[]
}

model FoodOrderItem {
  id           String @id @default(uuid())
  orderId      String
  menuItemId   String
  quantity     Int    @default(1)
  unitPrice    Float
  totalPrice   Float
  specialNotes String?

  order    FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem  @relation(fields: [menuItemId], references: [id])
}

model HousekeepingTask {
  id             String   @id @default(uuid())
  roomId         String
  taskType       String   @default("ROOM_CLEANING") // ROOM_CLEANING, BATHROOM_CLEANING, LINEN_CHANGE, DEEP_CLEANING, INSPECTION
  priority       String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status         String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, INSPECTED
  assignedStaffId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  room          Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedStaff Staff? @relation(fields: [assignedStaffId], references: [id])
}

model MaintenanceRequest {
  id              String   @id @default(uuid())
  roomId          String
  issueTitle      String
  description     String?
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  assignedStaffId String?
  reportedBy      String   @default("Housekeeping")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  room          Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedStaff Staff? @relation(fields: [assignedStaffId], references: [id])
}

model Staff {
  id          String   @id @default(uuid())
  userId      String   @unique
  employeeId  String   @unique
  department  String   // RECEPTION, HOUSEKEEPING, RESTAURANT, KITCHEN, ACCOUNTS, MANAGEMENT
  designation String
  joinDate    String
  salary      Float
  shift       String   @default("Morning (07:00 - 15:30)")
  status      String   @default("ACTIVE") // ACTIVE, ON_LEAVE, INACTIVE

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceRecords   StaffAttendance[]
  assignedHousekeeping HousekeepingTask[]
  assignedMaintenance  MaintenanceRequest[]
  shifts              StaffShift[]
}

model StaffAttendance {
  id           String   @id @default(uuid())
  staffId      String
  date         String   // YYYY-MM-DD
  checkInTime  String?
  checkOutTime String?
  status       String   @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, ON_LEAVE
  notes        String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model StaffShift {
  id        String @id @default(uuid())
  staffId   String
  shiftName String // Morning, Afternoon, Night, General
  startTime String // 07:00
  endTime   String // 15:30
  daysOfWeek String // "Mon,Tue,Wed,Thu,Fri"

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String
  category      String   @default("Food") // Food, Beverage, Linen, Cleaning, Equipment, Other
  status        String   @default("Active") // Active, Inactive
  address       String?
  notes         String?
  createdAt     DateTime @default(now())

  ingredients Ingredient[]
  purchases   Purchase[]
  products    SupplierProduct[]
}

model SupplierProduct {
  id               String    @id @default(uuid())
  supplierId       String
  name             String
  category         String    @default("General") // Food, Dairy, Beverage, Linen, Cleaning, Equipment, Service
  type             String    @default("PRODUCT") // PRODUCT, SERVICE
  description      String?
  unit             String    @default("Pcs") // Liter, Kg, 500 ml, 100 g, Pcs, Case, Unit, Pack, Job
  purchasePrice    Float     @default(0.0)
  moq              Float     @default(1.0)
  reorderLevel     Float     @default(10.0)
  currentStock     Float     @default(0.0)
  taxRate          Float     @default(18.0)
  status           String    @default("ACTIVE") // ACTIVE, INACTIVE
  lastPurchaseDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  supplier  Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchases Purchase[]
}

model Purchase {
  id           String   @id @default(uuid())
  supplierId   String
  productId    String?
  itemNames    String
  quantity     String   @default("1")
  unitPrice    Float    @default(0.0)
  taxAmount    Float    @default(0.0)
  totalCost    Float
  status       String   @default("PENDING") // PENDING, RECEIVED, CANCELLED, COMPLETED
  notes        String?
  purchaseDate DateTime @default(now())

  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierProduct SupplierProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model InventoryTransaction {
  id           String   @id @default(uuid())
  ingredientId String
  type         String   // STOCK_IN, STOCK_OUT, USAGE, WASTAGE
  quantity     Float
  reason       String?
  cost         Float    @default(0.0)
  createdAt    DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model Expense {
  id            String   @id @default(uuid())
  category      String   // SALARY, FOOD_PURCHASE, MAINTENANCE, ELECTRICITY, WATER, INTERNET, MARKETING, OTHER
  title         String
  amount        Float
  date          DateTime @default(now())
  paymentMethod String   @default("BANK_TRANSFER")
  notes         String?
  receiptUrl    String?
  createdAt     DateTime @default(now())
}

model Review {
  id                   String   @id @default(uuid())
  guestId              String
  rating               Int      // 1 to 5
  comment              String
  sentiment            String   @default("POSITIVE") // POSITIVE, NEUTRAL, NEGATIVE
  roomExperienceRating Int      @default(5)
  foodServiceRating    Int      @default(5)
  mainIssue            String?
  suggestedAction      String?
  createdAt            DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(uuid())
  title      String
  message    String
  type       String   @default("INFO") // INFO, WARNING, SUCCESS, ALERT
  isRead     Boolean  @default(false)
  targetRole String   @default("ALL")
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?  @default("127.0.0.1")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String?
  prompt    String
  response  String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model AIPrediction {
  id         String   @id @default(uuid())
  type       String   // FOOD_DEMAND, OCCUPANCY, REVENUE
  targetDate String
  dataJson   String
  createdAt  DateTime @default(now())
}

model AIRecommendation {
  id             String   @id @default(uuid())
  category       String   // PRICING, PROMOTION, INVENTORY, SERVICE
  priority       String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  title          String
  reason         String
  expectedImpact String
  actionText     String
  isDismissed    Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Hall {
  id                   String   @id @default(uuid())
  name                 String   @unique
  slug                 String   @unique
  description          String?
  sizeSqFt             Int
  capacity             Int
  theatreCapacity      Int      @default(0)
  roundTableCapacity   Int      @default(0)
  classroomCapacity    Int      @default(0)
  boardroomCapacity    Int      @default(0)
  pricePerDay          Float
  status               String   @default("AVAILABLE") // AVAILABLE, BOOKED, RESERVED, MAINTENANCE
  imageUrl             String
  amenities            String   // Comma separated e.g. "Stage, Sound System, AC, Projector"
  suitableFor          String   // Comma separated e.g. "Weddings, Conferences, Receptions"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  bookings             HallBooking[]
  events               Event[]
}

model HallBooking {
  id                   String   @id @default(uuid())
  bookingCode          String   @unique
  hallId               String
  guestId              String?
  customerName         String
  customerPhone        String
  customerEmail        String?
  eventType            String   // Wedding, Reception, Birthday, Engagement, Corporate Event, Conference, Seminar, Meeting, Workshop, Other
  eventDate            DateTime
  startTime            String   @default("09:00 AM")
  endTime              String   @default("06:00 PM")
  guestCount           Int
  specialRequirements  String?
  hallCharge           Float
  decorationCharge     Float    @default(0.0)
  cateringCharge       Float    @default(0.0)
  extraEquipmentCharge Float    @default(0.0)
  tax                  Float    @default(0.0)
  totalAmount          Float
  paymentStatus        String   @default("PENDING") // PENDING, PAID, PARTIAL
  bookingStatus        String   @default("CONFIRMED") // CONFIRMED, PENDING, COMPLETED, CANCELLED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  hall                 Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)
  guest                Guest?   @relation(fields: [guestId], references: [id])
}

model Event {
  id                   String   @id @default(uuid())
  eventNumber          String   @unique // EVT-2026-0001
  name                 String
  eventType            String   // Wedding, Reception, Engagement, Birthday Party, Anniversary, Corporate Event, Conference, Seminar, Workshop, Product Launch, Training Program, Business Meeting, Private Party, Social Gathering, Other
  guestId              String?
  customerName         String
  customerPhone        String
  customerEmail        String?
  companyName          String?
  gstNumber            String?
  hallId               String
  eventDate            DateTime
  startTime            String   @default("09:00 AM")
  endTime              String   @default("06:00 PM")
  expectedGuests       Int
  seatingArrangement   String   @default("Banquet") // Theatre, Round Table, Classroom, Boardroom, U-Shape, Banquet, Custom
  description          String?
  specialRequirements  String?
  
  // Pricing breakdown
  hallCharge           Float    @default(0.0)
  cateringType         String   @default("NONE") // NONE, PER_PERSON, FIXED_PACKAGE, CUSTOM_MENU
  cateringPricePerPerson Float  @default(0.0)
  cateringItemsJson    String?  // JSON string of selected menu items with qty & price
  cateringAmount       Float    @default(0.0)
  
  decorationType       String   @default("BASIC") // BASIC, STANDARD, PREMIUM, LUXURY, CUSTOM
  decorationAmount     Float    @default(0.0)
  
  servicesJson         String?  // JSON string of additional services (DJ, Photography, LED Wall, etc.)
  servicesAmount       Float    @default(0.0)
  
  subtotal             Float    @default(0.0)
  discountType         String   @default("FIXED") // FIXED, PERCENTAGE
  discountValue        Float    @default(0.0)
  discountAmount       Float    @default(0.0)
  taxRate              Float    @default(18.0) // 18% GST default
  taxAmount            Float    @default(0.0)
  grandTotal           Float    @default(0.0)
  
  advancePayment       Float    @default(0.0)
  paidAmount           Float    @default(0.0)
  remainingAmount      Float    @default(0.0)
  paymentStatus        String   @default("PENDING") // PENDING, PARTIAL, PAID, REFUNDED
  bookingStatus        String   @default("CONFIRMED") // DRAFT, PENDING, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED
  
  checklistJson        String?  // JSON checklist of operational tasks
  staffAssignmentsJson String?  // JSON string of assigned staff profiles
  
  cancellationReason   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  guest                Guest?   @relation(fields: [guestId], references: [id])
  hall                 Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)
  payments             Payment[]
  invoices             Invoice[]
}

model GuestNote {
  id         String   @id @default(uuid())
  guestId    String
  authorName String   @default("Admin")
  content    String
  createdAt  DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model LoyaltyTransaction {
  id            String   @id @default(uuid())
  guestId       String
  type          String   // EARNED, REDEEMED, ADJUSTED, EXPIRED
  referenceType String   // ROOM_BOOKING, RESTAURANT_ORDER, EVENT_BOOKING, REWARD_REDEMPTION, MANUAL
  referenceId   String?
  amountSpent   Float    @default(0.0)
  points        Int
  balanceAfter  Int
  status        String   @default("COMPLETED") // COMPLETED, CANCELLED
  notes         String?
  createdAt     DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model LoyaltyReward {
  id             String   @id @default(uuid())
  name           String
  description    String?
  pointsRequired Int
  rewardType     String   // DISCOUNT, FREE_SERVICE, UPGRADE, COMPLIMENTARY
  rewardValue    Float    @default(0.0)
  expiryDays     Int      @default(30)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id             String    @id @default(uuid())
  redemptionCode String    @unique // LR-2026-000125
  guestId        String
  rewardId       String
  pointsUsed     Int
  status         String    @default("REDEEMED") // REDEEMED, USED, EXPIRED, CANCELLED
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  guest  Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reward LoyaltyReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
}

model CommunicationLog {
  id          String   @id @default(uuid())
  guestId     String
  channel     String   // WHATSAPP, EMAIL, CALL, SMS
  messageType String   // BIRTHDAY_WISH, THANK_YOU, FEEDBACK_REQUEST, LOYALTY_OFFER, CUSTOM
  subject     String?
  content     String
  status      String   @default("SENT") // DRAFT, QUEUED, SENT, FAILED
  sentAt      DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
}


