// HOTELNEX AI Prisma Schema
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF") // SUPER_ADMIN, HOTEL_MANAGER, RECEPTIONIST, HOUSEKEEPING, RESTAURANT_MANAGER, KITCHEN_STAFF, ACCOUNTANT, STAFF
  phone        String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffProfile Staff?
  auditLogs    AuditLog[]
  conversations AIConversation[]
}

model Guest {
  id            String   @id @default(uuid())
  name          String
  email         String?
  phone         String
  address       String?
  dateOfBirth   String?
  idType        String?  // Passport, Driving License, Aadhaar, National ID
  idNumber      String?
  nationality   String   @default("Indian")
  preferences   String?  // JSON or text: e.g. "Non-smoking, High Floor, Extra Pillows"
  totalStays    Int      @default(0)
  totalSpending Float    @default(0.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  documents     GuestDocument[]
  reservations  Reservation[]
  checkIns      CheckIn[]
  checkOuts     CheckOut[]
  invoices      Invoice[]
  foodOrders    FoodOrder[]
  reviews       Review[]
}

model GuestDocument {
  id           String   @id @default(uuid())
  guestId      String
  documentType String   // ID Proof, Visa, Passport
  documentUrl  String
  uploadedAt   DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model RoomType {
  id          String   @id @default(uuid())
  name        String   // Standard, Deluxe, Premium, Suite, Family
  code        String   @unique
  basePrice   Float
  description String?
  capacity    Int      @default(2)
  bedType     String   @default("King") // King, Queen, Twin, Double
  amenities   String   // Comma separated e.g. "Wi-Fi, AC, TV, Mini Bar, Sea View"
  image       String?
  createdAt   DateTime @default(now())

  rooms Room[]
}

model Room {
  id            String   @id @default(uuid())
  roomNumber    String   @unique
  roomTypeId    String
  floor         Int      @default(1)
  pricePerNight Float
  capacity      Int      @default(2)
  bedType       String   @default("King")
  amenities     String
  status        String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, CLEANING, MAINTENANCE, OUT_OF_SERVICE
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roomType            RoomType              @relation(fields: [roomTypeId], references: [id])
  reservations        Reservation[]
  checkIns            CheckIn[]
  checkOuts           CheckOut[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]
  foodOrders          FoodOrder[]
}

model Reservation {
  id             String   @id @default(uuid())
  bookingCode    String   @unique
  guestId        String
  roomId         String
  checkInDate    DateTime
  checkOutDate   DateTime
  adults         Int      @default(1)
  children       Int      @default(0)
  nights         Int      @default(1)
  roomRate       Float
  discount       Float    @default(0.0)
  tax            Float    @default(0.0)
  totalAmount    Float
  advancePayment Float    @default(0.0)
  remainingAmount Float
  source         String   @default("DIRECT") // DIRECT, WEBSITE, PHONE, WALK_IN, OTA
  status         String   @default("CONFIRMED") // CONFIRMED, PENDING, CHECKED_IN, CHECKED_OUT, CANCELLED, NO_SHOW
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guest    Guest    @relation(fields: [guestId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])
  checkIn  CheckIn?
  checkOut CheckOut?
  payments Payment[]
  invoices Invoice[]
}

model CheckIn {
  id             String   @id @default(uuid())
  reservationId  String   @unique
  roomId         String
  guestId        String
  checkInTime    DateTime @default(now())
  idVerified     Boolean  @default(true)
  keyCardNumber  String?
  initialDeposit Float    @default(0.0)
  notes          String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room        Room        @relation(fields: [roomId], references: [id])
  guest       Guest       @relation(fields: [guestId], references: [id])
}

model CheckOut {
  id                    String   @id @default(uuid())
  reservationId         String   @unique
  roomId                String
  guestId               String
  checkOutTime          DateTime @default(now())
  totalRoomCharges      Float
  totalRestaurantCharges Float   @default(0.0)
  totalServiceCharges   Float    @default(0.0)
  discounts             Float    @default(0.0)
  taxes                 Float    @default(0.0)
  finalAmount           Float
  paymentMethod         String   @default("CASH") // CASH, UPI, CARD, BANK_TRANSFER
  invoiceId             String?
  notes                 String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room        Room        @relation(fields: [roomId], references: [id])
  guest       Guest       @relation(fields: [guestId], references: [id])
}

model Payment {
  id            String   @id @default(uuid())
  reservationId String?
  orderId       String?
  invoiceId     String?
  amount        Float
  method        String   @default("CASH") // CASH, UPI, CARD, BANK_TRANSFER
  status        String   @default("PAID") // PAID, PARTIAL, PENDING, REFUNDED
  transactionId String?
  notes         String?
  createdAt     DateTime @default(now())

  reservation Reservation? @relation(fields: [reservationId], references: [id])
  foodOrder   FoodOrder?   @relation(fields: [orderId], references: [id])
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
}

model Invoice {
  id             String   @id @default(uuid())
  invoiceNumber  String   @unique
  guestId        String
  reservationId  String?
  checkOutId     String?
  issueDate      DateTime @default(now())
  dueDate        DateTime?
  subtotal       Float
  taxAmount      Float
  discountAmount Float    @default(0.0)
  grandTotal     Float
  status         String   @default("PAID") // PAID, UNPAID, PARTIAL, CANCELLED
  itemsJson      String   // JSON string of itemized breakdown
  createdAt      DateTime @default(now())

  guest       Guest        @relation(fields: [guestId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  payments    Payment[]
}

model RestaurantTable {
  id             String   @id @default(uuid())
  tableNumber    String   @unique
  capacity       Int      @default(4)
  floor          String   @default("Main Dining")
  status         String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, BILL_REQUESTED
  currentOrderId String?

  orders FoodOrder[]
}

model MenuCategory {
  id           String   @id @default(uuid())
  name         String   @unique // Starters, Main Course, Pizza, Burger, Indian, Beverages, Desserts, Combos
  description  String?
  icon         String   @default("Utensils")
  displayOrder Int      @default(0)

  menuItems MenuItem[]
}

model MenuItem {
  id              String   @id @default(uuid())
  categoryId      String
  name            String
  description     String?
  image           String?
  price           Float
  costPrice       Float    @default(0.0)
  taxRate         Float    @default(5.0)
  isVeg           Boolean  @default(true)
  isJain          Boolean  @default(false)
  prepTimeMinutes Int      @default(15)
  isAvailable     Boolean  @default(true)
  isBestSeller    Boolean  @default(false)
  createdAt       DateTime @default(now())

  category   MenuCategory    @relation(fields: [categoryId], references: [id])
  recipe     Recipe?
  orderItems FoodOrderItem[]
}

model Ingredient {
  id           String   @id @default(uuid())
  name         String   @unique
  category     String   @default("General") // Dairy, Produce, Flour, Spices, Meat, Beverages
  unit         String   @default("kg") // kg, g, l, ml, pcs
  currentStock Float    @default(0.0)
  minimumStock Float    @default(5.0)
  purchasePrice Float   @default(0.0)
  supplierId   String?
  expiryDate   String?

  supplier          Supplier?              @relation(fields: [supplierId], references: [id])
  recipeIngredients RecipeIngredient[]
  transactions      InventoryTransaction[]
}

model Recipe {
  id           String   @id @default(uuid())
  menuItemId   String   @unique
  name         String
  instructions String?

  menuItem           MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  recipeIngredients RecipeIngredient[]
}

model RecipeIngredient {
  id               String @id @default(uuid())
  recipeId         String
  ingredientId     String
  quantityRequired Float  // e.g. 0.2 for 200g
  unit             String @default("kg")

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model FoodOrder {
  id            String   @id @default(uuid())
  orderNumber   String   @unique
  orderType     String   @default("DINE_IN") // DINE_IN, TAKEAWAY, ROOM_SERVICE, ONLINE
  tableId       String?
  roomId        String?
  guestId       String?
  status        String   @default("NEW") // NEW, CONFIRMED, PREPARING, READY, SERVED, COMPLETED, CANCELLED
  subtotal      Float
  tax           Float    @default(0.0)
  discount      Float    @default(0.0)
  totalAmount   Float
  paymentStatus String   @default("PENDING") // PENDING, PAID, BILLED_TO_ROOM
  kitchenNotes  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  table    RestaurantTable? @relation(fields: [tableId], references: [id])
  room     Room?            @relation(fields: [roomId], references: [id])
  guest    Guest?           @relation(fields: [guestId], references: [id])
  items    FoodOrderItem[]
  payments Payment[]
}

model FoodOrderItem {
  id           String @id @default(uuid())
  orderId      String
  menuItemId   String
  quantity     Int    @default(1)
  unitPrice    Float
  totalPrice   Float
  specialNotes String?

  order    FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem  @relation(fields: [menuItemId], references: [id])
}

model HousekeepingTask {
  id             String   @id @default(uuid())
  roomId         String
  taskType       String   @default("ROOM_CLEANING") // ROOM_CLEANING, BATHROOM_CLEANING, LINEN_CHANGE, DEEP_CLEANING, INSPECTION
  priority       String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status         String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, INSPECTED
  assignedStaffId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  room          Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedStaff Staff? @relation(fields: [assignedStaffId], references: [id])
}

model MaintenanceRequest {
  id              String   @id @default(uuid())
  roomId          String
  issueTitle      String
  description     String?
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  assignedStaffId String?
  reportedBy      String   @default("Housekeeping")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  room          Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedStaff Staff? @relation(fields: [assignedStaffId], references: [id])
}

model Staff {
  id          String   @id @default(uuid())
  userId      String   @unique
  employeeId  String   @unique
  department  String   // RECEPTION, HOUSEKEEPING, RESTAURANT, KITCHEN, ACCOUNTS, MANAGEMENT
  designation String
  joinDate    String
  salary      Float
  shift       String   @default("Morning (07:00 - 15:30)")
  status      String   @default("ACTIVE") // ACTIVE, ON_LEAVE, INACTIVE

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceRecords   StaffAttendance[]
  assignedHousekeeping HousekeepingTask[]
  assignedMaintenance  MaintenanceRequest[]
  shifts              StaffShift[]
}

model StaffAttendance {
  id           String   @id @default(uuid())
  staffId      String
  date         String   // YYYY-MM-DD
  checkInTime  String?
  checkOutTime String?
  status       String   @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, ON_LEAVE
  notes        String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model StaffShift {
  id        String @id @default(uuid())
  staffId   String
  shiftName String // Morning, Afternoon, Night, General
  startTime String // 07:00
  endTime   String // 15:30
  daysOfWeek String // "Mon,Tue,Wed,Thu,Fri"

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String
  address       String?

  ingredients Ingredient[]
  purchases   Purchase[]
}

model Purchase {
  id           String   @id @default(uuid())
  supplierId   String
  itemNames    String
  totalCost    Float
  status       String   @default("COMPLETED") // PENDING, ORDERED, COMPLETED
  purchaseDate DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
}

model InventoryTransaction {
  id           String   @id @default(uuid())
  ingredientId String
  type         String   // STOCK_IN, STOCK_OUT, USAGE, WASTAGE
  quantity     Float
  reason       String?
  cost         Float    @default(0.0)
  createdAt    DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model Expense {
  id            String   @id @default(uuid())
  category      String   // SALARY, FOOD_PURCHASE, MAINTENANCE, ELECTRICITY, WATER, INTERNET, MARKETING, OTHER
  title         String
  amount        Float
  date          DateTime @default(now())
  paymentMethod String   @default("BANK_TRANSFER")
  notes         String?
  receiptUrl    String?
  createdAt     DateTime @default(now())
}

model Review {
  id                   String   @id @default(uuid())
  guestId              String
  rating               Int      // 1 to 5
  comment              String
  sentiment            String   @default("POSITIVE") // POSITIVE, NEUTRAL, NEGATIVE
  roomExperienceRating Int      @default(5)
  foodServiceRating    Int      @default(5)
  mainIssue            String?
  suggestedAction      String?
  createdAt            DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(uuid())
  title      String
  message    String
  type       String   @default("INFO") // INFO, WARNING, SUCCESS, ALERT
  isRead     Boolean  @default(false)
  targetRole String   @default("ALL")
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?  @default("127.0.0.1")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String?
  prompt    String
  response  String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model AIPrediction {
  id         String   @id @default(uuid())
  type       String   // FOOD_DEMAND, OCCUPANCY, REVENUE
  targetDate String
  dataJson   String
  createdAt  DateTime @default(now())
}

model AIRecommendation {
  id             String   @id @default(uuid())
  category       String   // PRICING, PROMOTION, INVENTORY, SERVICE
  priority       String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  title          String
  reason         String
  expectedImpact String
  actionText     String
  isDismissed    Boolean  @default(false)
  createdAt      DateTime @default(now())
}
